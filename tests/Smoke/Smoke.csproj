<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runtime smoke test: loads the built mod, runs its real [StaticConstructorOnStartup] entry
       point in a bare .NET host (no game), and validates the drawprobe.log contract. This is what
       proves the probe cannot fail silently: the log must appear, start with the BUILD marker, and
       contain the member dump, the draw-api resolution and the hook report. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ProbeSmoke</AssemblyName>
    <RootNamespace>ProbeSmoke</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- the game stub must be present in the output: the mod binds to Assembly-CSharp at runtime -->
    <ProjectReference Include="../../stubs/GameStubs/GameStubs.csproj" />
    <ProjectReference Include="../../mod/AgentTouchFix.csproj" />
    <!-- 0Harmony must be in the output for the mod's own Harmony reference to resolve -->
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
  </ItemGroup>

</Project>
