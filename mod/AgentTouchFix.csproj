<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AgentTouchFix</AssemblyName>
    <RootNamespace>AgentTouchFix</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <!-- the SDK would otherwise append +<git sha>, making builds irreproducible -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version>2.5.0</Version>
    <!-- Unique build marker, baked into the assembly as AssemblyMetadata("BuildStamp").
         CI passes -p:BuildStamp=<utc yyyyMMddHHmmssZ>; a local build gets the current time.
         DrawProbe writes "BUILD <version>-<stamp>" as the first line of drawprobe.log, which is how a
         log file is tied back to exactly one artifact. -->
    <BuildStamp Condition="'$(BuildStamp)' == ''">$([System.DateTime]::UtcNow.ToString("yyyyMMddHHmmss"))Z</BuildStamp>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildStamp" Value="$(BuildStamp)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Harmony (0Harmony): the game loads its own copy, this is a compile-time reference only -->
    <PackageReference Include="Lib.Harmony" Version="2.3.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- reference-only game stub: assembly name matches the shipped Assembly-CSharp -->
    <ProjectReference Include="../stubs/GameStubs/GameStubs.csproj" Private="false" />
  </ItemGroup>

</Project>
